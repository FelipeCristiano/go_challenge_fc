# ============================================================
# Aplicação
# ============================================================
HTTP_PORT=3000

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=postgres://desafio:desafio@localhost:5432/desafio?sslmode=disable

# ============================================================
# AWS / LocalStack
# ============================================================
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# ============================================================
# Keycloak / OIDC
# ============================================================
KEYCLOAK_ISSUER=http://localhost:8080/realms/desafio
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/desafio/protocol/openid-connect/certs

# ============================================================
# SQS Consumer
# ============================================================
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=60
SQS_WAIT_TIME=20
SQS_MAX_RETRIES=5

# ============================================================
# Outbox Worker
# ============================================================
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# ============================================================
# PENDING_REFERENCE Worker
# ============================================================
PENDING_REF_POLL_INTERVAL=5s
PENDING_REF_MAX_RETRIES=10
PENDING_REF_INITIAL_BACKOFF=5s

# ============================================================
# Shutdown
# ============================================================
SHUTDOWN_TIMEOUT=30s
